# ==================== ОБЯЗАТЕЛЬНЫЕ ====================

# Токен бота (получить у @BotFather)
BOT_TOKEN=

# Юзернейм бота (без @) — используется для генерации имён стикер-паков
# Формат имени пака: <name>_by_<BOT_USERNAME>
BOT_USERNAME=your_sticker_bot

# ==================== БАЗА ДАННЫХ ====================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_sticker
DB_USER=bot_4_sticker
DB_PASSWORD=

# ==================== АДМИНЫ ====================

# Telegram ID админов через запятую
ADMIN_IDS=
ADMIN_USERNAME=admin

# ==================== КЭШ ====================

# Кэш обработанных медиа в БД (дни)
CACHE_TTL_DAYS=1

# ==================== ПРИМЕЧАНИЕ ====================
# API_ID / API_HASH не нужны: стикер-бот работает через стандартный Bot API
# (стикеры не превышают 50 МБ — Local Bot API не требуется)
